diff --git a/src/common/Configuration/Config.cpp b/src/common/Configuration/Config.cpp
index 79c58af..75b974b 100644
--- a/src/common/Configuration/Config.cpp
+++ b/src/common/Configuration/Config.cpp
@@ -708,6 +708,11 @@ std::string const ConfigMgr::GetConfigPath()
 #if AC_PLATFORM == AC_PLATFORM_WINDOWS
     return "configs/";
 #else
+    // _CONF_DIR is fixed at build time (a host path when cross-compiling); let the
