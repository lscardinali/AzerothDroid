@@ -124,6 +124,19 @@ public:
     [[nodiscard]] std::vector<PreparedStatementData> const& GetParameters() const { return statement_data; }
 
 protected:
+    // libc++ (Android) uses long long for e.g. std::chrono::duration::rep, a distinct type from
+    // int64 (long) on LP64 targets. Map it onto the integer types statement_data can hold.
+    template<typename T>
+    static constexpr auto NormalizeInteger(T value)
+    {
+        if constexpr (std::is_same_v<T, long long> && !std::is_same_v<long long, int64>)
+            return static_cast<int64>(value);
+        else if constexpr (std::is_same_v<T, unsigned long long> && !std::is_same_v<unsigned long long, uint64>)
+            return static_cast<uint64>(value);
+        else
+            return value;
+    }
+
     template<typename T>
     Acore::Types::is_non_string_view_v<T> SetValidData(const uint8 index, T const& value);
 
