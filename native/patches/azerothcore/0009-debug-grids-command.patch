+    // Grids created (terrain loaded) and loaded (objects spawned) per map, and this
+    // process's memory: grids are never unloaded, so this is what grows as players roam.
+    static bool HandleDebugGridsCommand(ChatHandler* handler)
+    {
+        uint32 created = 0, loaded = 0;
+        sMapMgr->DoForAllMaps([&](Map* map)
+        {
+            if (!map->GetCreatedGridsCount())
+                return;
+            created += map->GetCreatedGridsCount();
+            loaded += map->GetLoadedGridsCount();
+            handler->PSendSysMessage("Map {} ({}, instance {}): {} created, {} loaded grids", map->GetId(),
+                map->GetMapName(), map->GetInstanceId(), map->GetCreatedGridsCount(), map->GetLoadedGridsCount());
+        });
+        handler->PSendSysMessage("Total: {} created, {} loaded grids", created, loaded);
+
+        std::ifstream status("/proc/self/status");
+        for (std::string line; std::getline(status, line);)
+            if (line.starts_with("VmRSS") || line.starts_with("VmSwap") || line.starts_with("VmHWM"))
+                handler->SendSysMessage(line);
+        return true;
+    }
