+// Grids are never unloaded, and loading one spawns its creatures, some of which wander into the
+// next grid. A creature no player drives only creates the grid it walks into (terrain, as for
+// AddToMap of an inactive object); its objects load once a player comes near.
+static bool LoadsGridObjects(Creature const* creature)
+{
+    return creature->isActiveObject() || creature->IsCharmedOwnedByPlayerOrPlayer();
+}
