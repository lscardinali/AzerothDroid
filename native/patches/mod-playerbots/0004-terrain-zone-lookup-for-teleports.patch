+// Zone of a teleport location from its grid's .map file alone, cached. sMapMgr->GetZoneId would
+// create the grid (loading terrain, vmaps and mmaps, which are never unloaded) for every candidate
+// spot each time a bot teleports, filling memory with grids nobody visits.
+uint32 RandomPlayerbotMgr::GetTerrainZoneId(WorldLocation const& loc)
+{
+    auto const key = std::make_tuple(loc.GetMapId(), int32(loc.GetPositionX()), int32(loc.GetPositionY()));
+    std::lock_guard<std::mutex> lock(_terrainZoneCacheLock);
+    if (auto itr = _terrainZoneCache.find(key); itr != _terrainZoneCache.end())
+        return itr->second;
+
+    GridCoord const coord = Acore::ComputeGridCoord(loc.GetPositionX(), loc.GetPositionY());
+    auto const grid = std::make_tuple(loc.GetMapId(), coord.x_coord, coord.y_coord);
+    if (grid != _lastTerrainGrid)
+    {
+        _lastTerrainGrid = grid;
+        _lastTerrain = std::make_unique<GridTerrainData>();
+        std::string const mapFileName = Acore::StringFormat("{}maps/{:03}{:02}{:02}.map", sWorld->GetDataPath(),
+                                                            loc.GetMapId(), coord.x_coord, coord.y_coord);
+        if (_lastTerrain->Load(mapFileName) != TerrainMapDataReadResult::Success)
+            _lastTerrain.reset();
+    }
+
+    uint32 zoneId = 0;
+    if (_lastTerrain)
+    {
+        uint16 const areaId = _lastTerrain->getArea(loc.GetPositionX(), loc.GetPositionY());
+        if (AreaTableEntry const* area = sAreaTableStore.LookupEntry(areaId))
+            zoneId = area->zone ? area->zone : area->ID;
+    }
+
+    _terrainZoneCache.emplace(key, zoneId);
+    return zoneId;
+}
