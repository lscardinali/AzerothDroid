+// Gives each bracket a share of its neighbours' real-player boost (weight above baseline), so
+// bots gather around players' levels, some above and some below, instead of in one bracket.
+// Disabled brackets (weight 0) stay disabled.
+void SpreadBoostToNeighbors(std::vector<float>& weights, float baseline, float share)
+{
+    if (share <= 0.0f)
+        return;
+
+    std::vector<float> boosts(weights.size(), 0.0f);
+    for (size_t i = 0; i < weights.size(); ++i)
+        if (weights[i] > 0.0f)
+            boosts[i] = std::max(0.0f, weights[i] - baseline);
+
+    for (size_t i = 0; i < weights.size(); ++i)
+    {
+        if (weights[i] <= 0.0f)
+            continue;
+        if (i > 0)
+            weights[i] += share * boosts[i - 1];
+        if (i + 1 < weights.size())
+            weights[i] += share * boosts[i + 1];
+    }
+}
+}
+
